{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lfamilia-store",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "keep_vars": true,
  "triggers": { "crons": ["*/15 * * * *", "15 2 * * *"] },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lfamilia-store-db",
      "database_id": "d13939fa-c5c6-4c0e-868a-912bb875fc8d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lfamilia-store-media"
    }
  ]
}
