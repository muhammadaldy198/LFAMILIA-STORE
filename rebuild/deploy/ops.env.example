# Copy to /etc/lfamilia/ops.env on the VPS. Do not commit live values.
REPO_DIR=/home/site/htdocs/lfamiliastore-repo
APP_SUBDIR=rebuild
REPO_REF=main
APP_USER=site
APP_GROUP=site
PHP_BIN=/usr/bin/php8.4
COMPOSER_BIN=/usr/local/bin/composer
NPM_BIN=/usr/bin/npm

PUBLIC_BASE_URL=https://lfamiliastore.my.id
ORIGIN_HEALTH_URL=http://127.0.0.1/health/ready
ORIGIN_HOST_HEADER=lfamiliastore.my.id
HEALTH_TIMEOUT_SECONDS=10

MYSQL_DEFAULTS_FILE=/etc/lfamilia/mysql-backup.cnf
MYSQL_ADMIN_DEFAULTS_FILE=/etc/lfamilia/mysql-admin.cnf
BACKUP_PASSPHRASE_FILE=/etc/lfamilia/backup.pass
BACKUP_DIR=/var/backups/lfamilia
BACKUP_RETENTION_DAYS=7
BACKUP_REQUIRE_REMOTE=true
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG=/etc/lfamilia/rclone.conf

BACKUP_CALENDAR=*-*-* 02:15:00
RESTORE_VERIFY_CALENDAR=Sun *-*-* 04:30:00
HEALTHCHECK_CALENDAR=*:0/5
