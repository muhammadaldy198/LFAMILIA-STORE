[Unit]
Description=LFAMILIA STORE Frontend
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=@@RUN_USER@@
Group=@@RUN_GROUP@@
WorkingDirectory=@@ROOT_DIR@@
Environment=NODE_ENV=production
Environment=VPS_FRONTEND_MODE=1
Environment=LARAVEL_INTERNAL_URL=http://127.0.0.1:8080
Environment=LFAMILIA_LARAVEL_INTERNAL_URL=http://127.0.0.1:8080
ExecStart=@@ROOT_DIR@@/node_modules/.bin/vinext start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
