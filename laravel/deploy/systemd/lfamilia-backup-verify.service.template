[Unit]
Description=Verify latest LFAMILIA MariaDB backup by restoring it
After=mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/lfamilia/ops.env
ExecStart=/usr/local/sbin/lfamilia-backup-verify
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
