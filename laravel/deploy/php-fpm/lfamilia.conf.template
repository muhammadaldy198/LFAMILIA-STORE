[lfamilia]

user = lfamilia
group = lfamilia

listen = /run/php/php8.3-fpm-lfamilia.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 10s
pm.max_requests = 500

chdir = /var/www/lfamilia-store/laravel

catch_workers_output = yes
clear_env = no

; Application upload validation accepts up to 5 MiB images.
php_admin_value[upload_max_filesize] = 6M
php_admin_value[post_max_size] = 8M
